Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"
  config.vm.hostname = "chronos"

  # Host-only network between the Ubuntu host and this VM.
  config.vm.network "private_network",
      ip: "192.168.56.14"

  config.vm.provider "virtualbox" do |vb|
    vb.name = "chapter14-ptp-grandmaster"
    vb.memory = 512
    vb.cpus = 1

    # Do not allow VirtualBox Guest Additions to "helpfully"
    # synchronize the grandmaster back to the host clock.
    vb.customize [
      "setextradata",
      :id,
      "VBoxInternal/Devices/VMMDev/0/Config/GetHostTimeDisabled",
      "1"
    ]
  end

  config.vm.provision "shell", inline: <<-SHELL
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y linuxptp ethtool

    # We want PTP to own this machine's notion of time.
    timedatectl set-ntp false || true
    systemctl disable --now systemd-timesyncd.service || true
  SHELL
end
